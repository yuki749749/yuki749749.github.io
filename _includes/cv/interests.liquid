{% comment %}
  Unified interests entry renderer for both formats
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="interest-item mb-2">
      {% if entry.name %}
        <h6 class="font-weight-medium mb-3" style="font-size: 0.95rem;">{{ entry.name }}</h6>
      {% endif %}
      {% if entry.keywords %}
        <div class="row">
          {% for keyword in entry.keywords %}
            <div class="col-sm-4 mb-2">
              <span style="color: var(--global-theme-color); margin-right: 6px;">&bull;</span>
              {{ keyword }}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
  .interest-item {
    padding: 0.25rem 0;
  }
</style>
